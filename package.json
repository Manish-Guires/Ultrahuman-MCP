{
  "name": "ultrahuman-mcp",
  "version": "1.0.0",
  "description": "Read-only MCP server for Ultrahuman ring data (sleep, HRV, recovery, steps), hostable on Vercel as a claude.ai connector",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "ultrahuman-mcp": "dist/src/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start:stdio": "node dist/src/stdio.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}
