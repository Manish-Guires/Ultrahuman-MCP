# Copy to .env for local use, or add these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Required for the hosted server: a long random string (at least 24 characters).
# Generate one with: openssl rand -hex 32
MCP_ACCESS_KEY=

# Option 1: personal key from Ultrahuman support
ULTRAHUMAN_AUTH_TOKEN=
ULTRAHUMAN_USER_EMAIL=

# Option 2: OAuth app from Ultrahuman's developer dashboard
ULTRAHUMAN_CLIENT_ID=
ULTRAHUMAN_CLIENT_SECRET=
# Optional; defaults to https://<your-domain>/oauth/callback
ULTRAHUMAN_REDIRECT_URI=
# Needed for option 2 on Vercel (added automatically by Upstash Redis from the Vercel Marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=
